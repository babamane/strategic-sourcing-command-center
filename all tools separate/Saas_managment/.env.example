SAAS_SPEND_DB_PATH=data/saas_spend.db
SAAS_SPEND_UPLOADS_DIR=data/uploads
SAAS_SPEND_VENDOR_RULES_PATH=config/vendor_rules.py
SAAS_SPEND_AUDIT_DATE=2026-05-01
ACTIVE_VENDORS=Atlassify,Claude,Cloudora,Nexaflow,OpenAI
ROW_COUNT_DEVIATION_THRESHOLD=0.05
PIPELINE_API_BASE_URL=http://127.0.0.1:8010
TRUEUP_EXPOSURE_BASELINE_ANNUAL=216271
PIPELINE_EXPOSURE_THRESHOLD=0.10
PIPELINE_REPORT_OUTPUT_PATH=data/reports/pipeline_report.json

# Optional: absolute path to the external portfolio tracker CSV.
# When set, newly onboarded contract rows are appended to this file
# after each successful pipeline promotion.
# File is created with headers if it does not exist.
# Leave empty to skip export silently.
# Example: PORTFOLIO_EXPORT_PATH=C:/exports/portfolio_tracker.csv
PORTFOLIO_EXPORT_PATH=

# SMTP credentials for sending notifications (e.g. Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_password

# Notification Target for churn / renewal alerts
CHURN_NOTIFICATION_RECIPIENT=recipient@example.com
# Jira
JIRA_BASE_URL=your_jira_base_url
JIRA_EMAIL=your_email
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=your_jira_project_key