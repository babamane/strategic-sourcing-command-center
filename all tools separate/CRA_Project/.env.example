# ============================================================
# VendorFlow AI / CRA — Environment Configuration
# ============================================================
# NOTE: This project is intended to run under Python 3.11 only.
# Ensure you use the `py -3.11` interpreter when launching the app/backend.
# 1. Copy this file:   cp .env.example .env
# 2. Fill in your real values below
# 3. Never commit .env to git
# ============================================================

# ── Data directory (relative to cra_workflow/) ─────────────
DATA_DIR=data

# ── FastAPI base URL (used in email action-button links) ───
# Local dev:
BASE_URL=http://localhost:8000
# If using ngrok, replace with your tunnel URL:
# BASE_URL=https://xxxx-xx-xx-xx-xx.ngrok-free.app

# ── Gmail SMTP credentials ─────────────────────────────────
# Create a Gmail App Password at:
#   https://myaccount.google.com/apppasswords
# (Google Account → Security → 2-Step Verification → App passwords)
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ── Stakeholder email routing ──────────────────────────────
# If left blank, all emails fall back to SMTP_EMAIL.
PROCUREMENT_EMAIL=
FINANCE_EMAIL=
EXECUTIVE_EMAIL=
APPROVER_EMAIL=

# ── Optional integrations ──────────────────────────────────
# URL embedded in the 90-day escalation email for scheduling
MEETING_SCHEDULER_URL=https://calendly.com/renewal-strategy

# Google ADK intelligence agent (optional)
# GOOGLE_API_KEY=your_google_api_key
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=orieg/gemma3-tools:12b-ft
    